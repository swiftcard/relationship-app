<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The ONLY way into this app from outside it.
                 swiftcard:// carries the return leg of native sign-in
                 (swiftcard://auth-callback) and of every CRM integration
                 connect (swiftcard://google-callback, ://linkedin-callback,
                 ://salesforce-callback). NativeAppBridge listens for these via
                 @capacitor/app appUrlOpen; singleTask above is what makes them
                 arrive as onNewIntent instead of a second activity.

                 NO https FILTER, AND NEVER ONE. Owner, 2026-09-29: a tapped
                 SwiftCard link opened INSIDE the app, on a public card page
                 with no app chrome and no way out. "We do not want links ever
                 opening in that app." iOS enforces this by shipping no
                 Associated Domains entitlement and an association file that
                 excludes every path; the Android equivalent is simply never
                 claiming the domain — no autoVerify attribute, no https data element, and no
                 assetlinks.json served from the site. Pinned by tests/android-no-app-links.test.ts. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/custom_url_scheme" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Android 11+ hides other apps from this one unless they are declared
         here. Without this block ExternalPurchasePlugin's resolveActivity()
         returns null even with Chrome installed, so handing a card link to the
         browser silently reports "no browser" and nothing opens. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ requires a RUNTIME grant before any notification can be
         posted; without this declaration PushNotifications.requestPermissions()
         resolves "denied" on every modern device and push is silently dead. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
