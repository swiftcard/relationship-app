{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/sync-main.mjs\" --brief",
            "timeout": 30,
            "statusMessage": "Checking this folder against origin/main"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/sync-main.mjs\" --gate",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
