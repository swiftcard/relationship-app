# SwiftCard — Environment Variables
#
# Copy this file to `.env.local` for local dev and fill in real values.
# Add the same variables to Vercel → Settings → Environment Variables for production.
# NEVER commit `.env.local` (or any file with real secrets) to git.

# ── App URL ──────────────────────────────────────────────────────────────────
# Used for card links, email links, and OAuth/webhook redirect URIs — must match
# the domain registered in Google/HubSpot OAuth apps and your Stripe/Twilio dashboards.
NEXT_PUBLIC_APP_URL=https://swiftcard.me

# ── Supabase (required) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin panel ───────────────────────────────────────────────────────────────
# Comma-separated emails allowed into /admin (plan toggling, analytics, promo codes, broadcast).
ADMIN_EMAILS=

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
# NOTE: sender ADDRESSES are no longer env-configured. Every From, display name
# and Reply-To lives in src/lib/email-senders.ts — connect@ / support@ /
# billing@ / news@, with hello@ receive-only. Change them there, not here.
# RESEND_FROM_EMAIL is no longer read by any send site and can be deleted.
# Signing secret of the Resend webhook (email.bounced + email.complained →
# /api/resend/webhook). Without it the route refuses events and reports
# "resend.webhook.no-secret", and bounce/complaint suppression is not running.
RESEND_WEBHOOK_SECRET=
# Optional. Adds a mailto: method to List-Unsubscribe alongside the one-click
# https method. Only set it to an address that is actually provisioned.
UNSUBSCRIBE_MAILTO=
# Optional. Per-run cap for /api/admin/broadcast (default 200) — the warm-up ramp.
EMAIL_DAILY_SEND_CAP=
# Optional. Slack/Discord incoming-webhook URL; reportError() posts every
# critical-path failure (rejected email, cron, billing webhook) there in real time.
ALERT_WEBHOOK_URL=

# ── AI follow-up messages ────────────────────────────────────────────────────
# Tried in this order: OPENAI_API_KEY, then GEMINI_API_KEY, then ANTHROPIC_API_KEY.
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ── Cron ──────────────────────────────────────────────────────────────────────
# Shared secret for scheduled/cron-triggered routes (e.g. /api/reminders).
CRON_SECRET=

# ── OAuth token encryption (Google CRM sync + HubSpot token storage) ─────────
# 32-byte key as 64 hex chars. Generate with: openssl rand -hex 32
# HubSpot itself needs no client ID/secret here — each user pastes their own
# Private App access token directly in Settings → Integrations.
OAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Web Google sign-in (Google Identity Services, ID-token flow) ─────────────
# The Google Cloud "Web application" OAuth Client ID, exposed to the browser so
# Google Identity Services can render the sign-in button. Must ALSO be added to
# the Supabase Google provider's "Authorized Client IDs" list, or
# signInWithIdToken rejects the token. Distinct from GOOGLE_CLIENT_ID above
# (that one is the server-side Google CRM-integration client).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── LinkedIn profile-photo import (optional) ─────────────────────────────────
# "Sign In with LinkedIn using OpenID Connect" OAuth app. Lets a user import
# their LinkedIn profile photo onto a card (they approve before it's applied).
# Requires the product to be ADDED and APPROVED on the LinkedIn app — until then
# the Connect button stays hidden (both vars must be set to surface it).
# Redirect URI to register: ${NEXT_PUBLIC_APP_URL}/api/integrations/linkedin/callback
# Scopes: openid profile email
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Agent Flow → Settings → Connections (owner-only OAuth; tokens stored
# encrypted in agent_connections). Only the platform APPS live here.
X_CLIENT_ID=
X_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
YOUTUBE_CLIENT_ID=      # OAuth client in the hello@swiftcard.me Workspace project (Internal consent screen); falls back to GOOGLE_CLIENT_ID
YOUTUBE_CLIENT_SECRET=
LINKEDIN_AGENT_CLIENT_ID=     # the "SwiftCard Agent Flow" LinkedIn app (Page-attached); falls back to LINKEDIN_CLIENT_ID
LINKEDIN_AGENT_CLIENT_SECRET=
# META_PAGE_ID=            # only if the login admins several Pages
# LINKEDIN_AGENT_SCOPES=   # add w_organization_social r_organization_admin once LinkedIn grants Page access
# LINKEDIN_ALLOW_MEMBER_POSTS=1   # off by default: public posts come from SwiftCard, not a person

# ── Company logo suggestion (optional) ───────────────────────────────────────
# Logo.dev Brand Search API secret key (format sk_...). Suggests a company's
# official logo when a user enters a company name / business email / domain.
# Without it, the "Suggest my company logo" helper stays hidden — nothing breaks.
# Get one at https://www.logo.dev (dashboard → API key).
LOGO_DEV_TOKEN=

# ── Web push notifications ───────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Apple Wallet pass (digital business card) ────────────────────────────────
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT_PEM=
APPLE_PASS_KEY_PEM=
APPLE_PASS_KEY_PASSWORD=
APPLE_WWDR_PEM=
# HMAC secret for each pass's update-service token. Falls back to
# APPLE_PASS_KEY_PEM when unset — which means renewing the signing key would
# invalidate every installed pass's token and silently stop their updates.
# Set this to the CURRENT APPLE_PASS_KEY_PEM value once (tokens stay
# identical); after that the certificate can be renewed freely.
WALLET_AUTH_SECRET=

# ── App Store link (iOS app promo popup) ─────────────────────────────────────
NEXT_PUBLIC_APP_STORE_URL=
# The numeric App Store id (digits only). Builds every "Rate us" link
# (https://apps.apple.com/app/id<ID>?action=write-review), swiftcard.me/review
# and the Smart App Banner. Optional when the URL above already contains it.
NEXT_PUBLIC_APP_STORE_ID=

# ══════════════════════════════════════════════════════════════════════════
# Stripe (payments) — see STRIPE_TWILIO_SETUP.md for the full dashboard walkthrough
# ══════════════════════════════════════════════════════════════════════════
#
# Test mode vs. live mode: Stripe keeps ENTIRELY SEPARATE data for test and live
# mode — separate API keys, separate Products/Prices, separate webhook signing
# secrets. A test-mode Price ID will NOT work with a live-mode secret key, and
# vice versa. To go live, create your Products/Prices again in live mode (or
# toggle "View live data" and duplicate them), then swap EVERY value below for
# its live-mode equivalent — do not mix test and live values.
#
# Which mode you're in is determined ENTIRELY by which key you put here:
#   sk_test_... / whsec_... (test endpoint)  → test mode, no real charges
#   sk_live_... / whsec_... (live endpoint)  → live mode, REAL charges
#
# Secret key — Stripe Dashboard → Developers → API keys → Secret key.
STRIPE_SECRET_KEY=

# Webhook signing secret — Dashboard → Developers → Webhooks → your endpoint →
# Signing secret. Test mode and live mode each have their OWN endpoint + secret.
STRIPE_WEBHOOK_SECRET=

# Price IDs — Dashboard → Product catalog → each price → copy the Price ID
# (starts with price_...). These must be recurring (subscription) prices in USD,
# and their amount MUST exactly match the prices shown on /pricing:
#   Pro monthly    → $4.99/mo
#   Pro annual     → $54.00/yr
#   Office monthly → $3.99/mo per seat (2-seat minimum)
#   Office annual  → $43.09/yr per seat (2-seat minimum)
# The checkout route (src/app/api/stripe/checkout/route.ts) verifies the live
# Stripe price against these amounts and refuses checkout on a mismatch — see
# PLAN_PRICES in src/lib/plan.ts, the single source of truth for both numbers.
NEXT_PUBLIC_STRIPE_MONTHLY_PRICE_ID=
NEXT_PUBLIC_STRIPE_ANNUAL_PRICE_ID=
NEXT_PUBLIC_STRIPE_ENTERPRISE_PRICE_ID=
NEXT_PUBLIC_STRIPE_ENTERPRISE_ANNUAL_PRICE_ID=
# Legacy/fallback Pro price ID (used only if a request omits priceId). Safe to
# leave unset if NEXT_PUBLIC_STRIPE_MONTHLY_PRICE_ID is set.
STRIPE_PRICE_ID=

# Optional: a Stripe Coupon ID offered on the account-cancellation "retain" flow.
STRIPE_RETENTION_COUPON_ID=

# ══════════════════════════════════════════════════════════════════════════
# Twilio (SMS) — see STRIPE_TWILIO_SETUP.md for the full dashboard walkthrough
# ══════════════════════════════════════════════════════════════════════════
#
# Console → Account → Account Info.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Preferred sender: a Messaging Service SID (Console → Messaging → Services).
# Falls back to a single phone number if unset. Set ONE of the two below.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# Inbound-SMS webhook signature check. Leave unset (or "false") in production —
# this exists ONLY to bypass signature validation in local dev when Twilio can't
# reach localhost. Never set to "true" in a deployed environment.
TWILIO_SKIP_VALIDATION=false

# ══════════════════════════════════════════════════════════════════════════
# RevenueCat — In-App Purchase for the iOS shell (App Review 3.1.1 remedy).
# All three fail closed when unset: no paywall renders, the webhook refuses,
# the sync route no-ops. See docs/IAP-SETUP.md for the one-time dashboard setup.
#
# Public SDK key for the App Store app (RevenueCat → Project → API keys,
# "Apple App Store" public key, appl_...). Baked into the client bundle at
# build time — it is not a secret, but the paywall cannot render without it.
NEXT_PUBLIC_RC_APPLE_API_KEY=
# Secret API key (sk_...) — server-only, used by /api/iap/sync to verify an
# entitlement with RevenueCat before granting Pro.
REVENUECAT_SECRET_KEY=
# Shared token RevenueCat sends back as its webhook Authorization header.
# Generated ours already: ~/.swiftcard/revenuecat-webhook-token.txt (also set
# in Vercel prod). Paste the same value into RevenueCat → Webhooks.
REVENUECAT_WEBHOOK_TOKEN=
