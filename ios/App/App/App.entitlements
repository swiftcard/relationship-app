<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- NO associated domains, on purpose (owner, 2026-09-29): no swiftcard.me
	     link may ever open this app — a SwiftCard, Swift Links or Swift
	     Signature link someone sends you opens in Safari/Chrome, never here.
	     Emptying the served AASA was not enough: each phone keeps the copy it
	     downloaded at install for days, so links kept opening the app. Without
	     this entitlement iOS never asks the app about any link. Sign-in and
	     integration returns use the swiftcard:// scheme (Info.plist), not
	     universal links. Do not add an associated-domains entry back. -->
	<!-- APNs push (EnablePushButton native path + lib/apns.ts). Xcode's signing
	     step rewrites this to "production" automatically for App Store builds. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Shared storage between the app and the SwiftCardWidget extension: the
	     webview writes the active card (via @capacitor/preferences group
	     config) and the widget renders its QR code from it. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.me.swiftcard.app</string>
	</array>
</dict>
</plist>
